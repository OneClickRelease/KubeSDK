# Spring Boot application.yaml for MySQL
spring:
  datasource:
    url: jdbc:mysql://{{host}}:{{port}}/{{database}}?useSSL=false&serverTimezone=UTC
    username: {{username}}
    password: {{password}}
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect